APP_ENV="development"
LOG_LEVEL="INFO"

# PIE Trader's own GenAI model/service — the default and only provider
# wired up so far, and it is a skeleton (see src/pie_genai/llm/providers/
# own_genai.py). Leaving these blank is expected right now; the platform
# then fails loudly on any LLM call instead of fabricating a response.
OWN_GENAI_ENDPOINT=""
OWN_GENAI_API_KEY=""

# Not wired to any route yet — present so docker-compose and config agree
# on the same variable names once persistence is implemented.
DATABASE_URL=""
REDIS_URL=""

# PIE Trader integration (read-only once implemented) — not wired yet.
PIE_TRADER_GATEWAY_URL="http://localhost:8080"
PIE_TRADER_API_TOKEN=""
